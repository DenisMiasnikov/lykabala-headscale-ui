# Local development settings for Headscale UI
# Copy this file to .env.local and adjust values as needed

# Headscale API URL (required)
# For local development, use your local Headscale instance URL.
# Default in Docker is http://headscale:8080.
HEADSCALE_URL=http://localhost:8080

# Headscale API key (optional if using API key file)
# Either HEADSCALE_API_KEY or HEADSCALE_API_KEY_FILE must be set.
HEADSCALE_API_KEY=

# Headscale API key file path (optional if using API key directly)
# Either HEADSCALE_API_KEY or HEADSCALE_API_KEY_FILE must be set.
HEADSCALE_API_KEY_FILE=

# Session secret (required for signing session cookies)
# Must be a long random string. Change this in production!
SESSION_SECRET=change_me_long_random

# UI admin credentials (optional, defaults shown)
UI_USERNAME=admin
UI_PASSWORD=change_me

# Cookie secure flag (default: false for local HTTP)
# Set to true if using HTTPS in production.
COOKIE_SECURE=false

# Users file path (optional, defaults to ./users.json)
# In Docker, this is typically /var/lib/headscale/users.json
USERS_FILE=./users.json
